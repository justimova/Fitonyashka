@page
@model Fytonyashka.Pages.Account.UserProfileModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="container">
    <h2>Your Profile</h2>
    <form method="post">
        <input type="hidden" asp-for="AccountInput.Id" />
        <input type="hidden" asp-for="AccountInput.User.Id" />
        <div class="form-group">
            <label asp-for="AccountInput.User.Username">Username</label>
            <input asp-for="AccountInput.User.Username" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="AccountInput.User.Email">Email</label>
            <input asp-for="AccountInput.User.Email" class="form-control" type="email" />
            <span asp-validation-for="AccountInput.User.Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="AccountInput.FirstName">First name</label>
            <input asp-for="AccountInput.FirstName" class="form-control" type="text" />
        </div>

        <div class="form-group">
            <label asp-for="AccountInput.Birthday">Birthday</label>
            <input asp-for="AccountInput.Birthday" class="form-control" type="date" />
        </div>

        <div class="form-group">
            <label asp-for="AccountInput.Height">Height (cm)</label>
            <input asp-for="AccountInput.Height" class="form-control" type="number" />
        </div>

        <button type="submit" class="btn btn-primary mt-3">Save</button>
    </form>
</div>