@page
@model Fytonyashka.Pages.Account.UserProfileModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="container">
    <h2>Your Profile</h2>
    <form method="post">
        <input type="hidden" asp-for="UserPrifileInput.Id" />
        <div class="form-group">
            <label asp-for="UserPrifileInput.Username">Username</label>
            <input asp-for="UserPrifileInput.Username" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="UserPrifileInput.Email">Email</label>
            <input asp-for="UserPrifileInput.Email" class="form-control" type="email" />
            <span asp-validation-for="UserPrifileInput.Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="UserPrifileInput.FirstName">First name</label>
            <input asp-for="UserPrifileInput.FirstName" class="form-control" type="text" />
        </div>

        <div class="form-group">
            <label asp-for="UserPrifileInput.Birthday">Birthday</label>
            <input asp-for="UserPrifileInput.Birthday" class="form-control" type="date" />
        </div>

        <div class="form-group">
            <label asp-for="UserPrifileInput.Height">Height (cm)</label>
            <input asp-for="UserPrifileInput.Height" class="form-control" type="number" />
        </div>

        <button type="submit" class="btn btn-primary mt-3">Save</button>
    </form>
</div>