@page
@model Fytonyashka.Pages.Sleep.SleepModel
@{
    ViewData["Title"] = "Sleep";
    bool hasValidationErrors = !ViewData.ModelState.IsValid;
}

<button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalEnterSleep">Enter</button>

<div class="container">
    <div>
        @foreach (var sleep in Model.DailySleeps)
        {
            <div class="border rounded p-3 mb-2 d-flex justify-content-between align-items-center">
                <div class="d-flex" style="min-width: 200px;">
                    <div style="width: 100px;" class="text-muted">
                        @sleep.Date.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture)
                        @sleep.Date.ToString("dd.MM")
                    </div>
                    <div class="fw-bold" style="font-size: 1rem; min-width: 60px;">
                        @sleep.SleepDuration
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <form method="post" asp-page-handler="Delete" asp-route-id="@sleep.Id">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this record?')">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade @(hasValidationErrors ? "show" : "")" id="modalEnterSleep" tabindex="-1" aria-hidden="true" style="@(hasValidationErrors ? "display:block;" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="EnterSleep">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Enter data of sleep</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="sleep-wake-form">
                        <input asp-for="SleepInputModel.UserId" type="hidden" />
                        <input asp-for="SleepInputModel.Id" type="hidden" />
                        <div class="mb-3">
                            <div class="fw-bold mb-2">Going to sleep</div>
                            <div class="mb-2">
                                <label asp-for="SleepInputModel.DateFrom" class="form-label">Date</label>
                                <input type="date" class="form-control" asp-for="SleepInputModel.DateFrom" />
                                <span asp-validation-for="SleepInputModel.DateFrom" class="text-danger"></span>
                            </div>
                            <div class="mb-2">
                                <label asp-for="SleepInputModel.TimeFrom" class="form-label">Time</label>
                                <input type="time" class="form-control" asp-for="SleepInputModel.TimeFrom" />
                                <span asp-validation-for="SleepInputModel.TimeFrom" class="text-danger"></span>
                            </div>
                        </div>
                        <div>
                            <div class="fw-bold mb-2">Waking up</div>
                            <div class="mb-2">
                                <label asp-for="SleepInputModel.DateTo" class="form-label">Date</label>
                                <input type="date" class="form-control" asp-for="SleepInputModel.DateTo" />
                                <span asp-validation-for="SleepInputModel.DateTo" class="text-danger"></span>
                            </div>
                            <div class="mb-2">
                                <label asp-for="SleepInputModel.TimeTo" class="form-label">Time</label>
                                <input type="time" class="form-control" asp-for="SleepInputModel.TimeTo" />
                                <span asp-validation-for="SleepInputModel.TimeTo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1055">
    <div id="sleepToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto">@TempData["ToastTitle"]</strong>
            <button type="button" class="btn-close ms-2 mb-1" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["ToastMessage"]
        </div>
    </div>
</div>

@section Scripts {
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        var toastEl = document.getElementById('sleepToast');
        if (toastEl.querySelector('.toast-body').textContent.trim() !== "") {
            var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
            toast.show();
        }

        @if (hasValidationErrors)
        {
            <text>
            var modal = new bootstrap.Modal(document.getElementById('modalEnterSleep'));
        modal.show();
            </text>
        }
    });
    </script>
}
