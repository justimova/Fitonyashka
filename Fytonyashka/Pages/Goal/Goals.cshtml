@page
@model Fytonyashka.Pages.Goal.GoalsModel
@{
    bool hasValidationErrors = !ViewData.ModelState.IsValid;
}

<div class="container">
    <h1>Your goals</h1>

    <div class="mb-4">
        <div style="min-width: 300px; max-width: 100px;">
            <button class="btn select-like-button w-100 d-flex justify-content-between align-items-center mb-2"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapsedWeight"
                    aria-expanded="true"
                    aria-controls="collapsedWeight">
                <span>Weight</span>
            </button>
        </div>

        <div class="collapse show" id="collapsedWeight">
            <div class="rounded mb-2 d-inline-flex justify-content-between align-items-center" style="width: auto;">
                <div class="d-flex flex-column" style="min-width: 300px; max-width: 600px;">
                    @if (Model.CurrentGoal != null)
                    {
                        <div class="d-flex flex-grow-1">
                            <div class="list-group w-100">
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>Your goal</span>
                                    <span class="text-muted">@Model.GetGoal()</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>Goal weight</span>
                                    <span class="text-muted">@Model.CurrentGoal.Weight kg</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>Start date</span>
                                    <span class="text-muted">@Model.CurrentGoal.StartDate.Date.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>Initial weight</span>
                                    <span class="text-muted">@Model.CurrentGoal.InitialWeight kg</span>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.CurrentGoal == null)
                    {
                        <div class="d-flex justify-content-between align-items-center p-2"
                             style="background-color: #f8f9fa; border-radius: 6px;">
                            <span>No goal set</span>
                            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalSetGoal">Set</button>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-end align-items-center p-2 mt-2"
                             style="background-color: #f8f9fa; border-radius: 6px;">
                            <form method="post" asp-page-handler="Delete">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this goal?')">Delete</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade @(hasValidationErrors ? "show" : "")" id="modalSetGoal" tabindex="-1" aria-hidden="true" style="@(hasValidationErrors ? "display:block;" : "")">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="SetGoal">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Set your goal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="InputGoal.Weight" class="form-label">Desirable weight (kg)</label>
                            <input type="number" class="form-control" asp-for="InputGoal.Weight">
                            <span asp-validation-for="InputGoal.Weight" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="InputGoal.InitialWeight" class="form-label">Initial weight (kg)</label>
                            <input type="number" class="form-control" asp-for="InputGoal.InitialWeight">
                            <span asp-validation-for="InputGoal.InitialWeight" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="InputGoal.StartDate" class="form-label">Start date</label>
                            <input type="date" class="form-control" asp-for="InputGoal.StartDate">
                            <span asp-validation-for="InputGoal.StartDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1055">
        <div id="goalToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">@TempData["ToastTitle"]</strong>
                <button type="button" class="btn-close ms-2 mb-1" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @TempData["ToastMessage"]
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toastEl = document.getElementById('goalToast');
            if (toastEl.querySelector('.toast-body').textContent.trim() !== "") {
                var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
                toast.show();
            }

            @if (hasValidationErrors)
            {
                <text>
                var modal = new bootstrap.Modal(document.getElementById('modalSetGoal'));
                modal.show();
                </text>
            }
        });
        </script>
    }
