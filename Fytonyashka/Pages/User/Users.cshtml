@page
@model UsersModel
@{
    ViewData["Title"] = "Users";
}

<div class="text-center mb-4">
    <button type="button" class="btn btn-primary" onclick="location.href='/User/Create'">Create User</button>
</div>

<div class="container">
    <div class="d-flex flex-wrap gap-3">
        @foreach (var user in Model.Users)
        {
            <div class="user-card flex-grow-0" style="min-width: 300px; flex-basis: calc(33.333% - 1rem);">
                <div class="border rounded p-3 h-100">
                    <div class="d-flex flex-column h-100">
                        <div class="mb-2">
                            <strong>ID:</strong> @user.Id
                        </div>
                        <div class="mb-2">
                            <strong>Username:</strong> @user.Username
                        </div>
                        <div class="mb-3">
                            <strong>Email:</strong> @user.Email
                        </div>
                        <div class="d-flex gap-2 mt-auto">
                            <button class="btn btn-warning flex-grow-1" onclick="location.href='/User/Update/@user.Id'">Update</button>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" class="flex-grow-1">
                                <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Are you sure you want to delete this user?')">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
